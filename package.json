{
  "name": "dsh-model-as-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Research and DSH plugin for turning Desert Ant Labs on-device models into agent tools",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "link:dsh": "node scripts/link-dsh.mjs && node scripts/ensure-v2-sdk.mjs",
    "ensure:v2-sdk": "node scripts/ensure-v2-sdk.mjs",
    "build": "npm run build:contracts && npm run build:sdk && npm run build:ext-tongue && npm run build:ext-voz && npm run build:ext-embeddinggemma && npm run build:ext-minilm-embed && npm run build:ext-minilm-rerank && npm run build:host && npm run build:recipes && npm run build:ext-needle && npm run build:ext-laya",
    "build:host": "node packages/dsh-model-as-tool/scripts/clean-lib.mjs && tsc -p packages/dsh-model-as-tool/tsconfig.build.json && node packages/dsh-model-as-tool/scripts/gen-client-catalog.mjs",
    "build:contracts": "tsc -p packages/tool-mode-contracts/tsconfig.build.json",
    "build:sdk": "tsc -p packages/tool-mode-extension-sdk/tsconfig.build.json",
    "typecheck": "tsc --noEmit -p packages/dsh-model-as-tool/tsconfig.json && tsc --noEmit -p packages/tool-mode-contracts/tsconfig.json && tsc --noEmit -p packages/tool-mode-extension-sdk/tsconfig.json && tsc --noEmit -p packages/extension-desert-ant-tongue/tsconfig.json && tsc --noEmit -p packages/extension-desert-ant-voz/tsconfig.json && tsc --noEmit -p packages/extension-embeddinggemma/tsconfig.json && tsc --noEmit -p packages/extension-minilm-embed/tsconfig.json && tsc --noEmit -p packages/extension-minilm-rerank/tsconfig.json && tsc --noEmit -p packages/tool-mode-recipes/tsconfig.json && tsc --noEmit -p packages/extension-needle/tsconfig.json && tsc --noEmit -p packages/extension-laya/tsconfig.json",
    "test": "tsx --test packages/dsh-model-as-tool/tests/*.test.ts packages/tool-mode-contracts/tests/*.test.ts packages/tool-mode-extension-sdk/tests/*.test.ts packages/extension-desert-ant-tongue/tests/*.test.ts packages/extension-desert-ant-voz/tests/*.test.ts packages/extension-embeddinggemma/tests/*.test.ts packages/extension-minilm-embed/tests/*.test.ts packages/extension-minilm-rerank/tests/*.test.ts packages/tool-mode-recipes/tests/*.test.ts packages/extension-needle/tests/*.test.ts packages/extension-laya/tests/*.test.ts packages/extension-declarative-recipes/tests/*.test.ts",
    "verify:built": "node scripts/verify-built.mjs && node packages/dsh-model-as-tool/scripts/gen-client-catalog.mjs --check",
    "verify:probe-isolation": "node scripts/check-probe-isolation.mjs",
    "verify:packed": "node scripts/check-probe-isolation.mjs && node scripts/verify-packed-install.mjs",
    "verify:orchestration": "node scripts/e2e-orchestration.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run verify:built && npm run verify:packed && npm run verify:architecture && npm run verify:mcp && npm run verify:verification && npm run verify:traceability",
    "verify:static": "npm run typecheck && npm run build && npm run verify:built && npm run verify:architecture && npm run verify:verification && npm run verify:traceability",
    "test:unit": "npm test",
    "test:contracts": "tsx --test packages/tool-mode-contracts/tests/*.test.ts packages/dsh-model-as-tool/tests/contracts-registration.test.ts",
    "test:extensions": "tsx --test packages/tool-mode-extension-sdk/tests/*.test.ts packages/extension-desert-ant-tongue/tests/*.test.ts packages/extension-desert-ant-voz/tests/*.test.ts packages/extension-embeddinggemma/tests/*.test.ts packages/extension-minilm-embed/tests/*.test.ts packages/extension-minilm-rerank/tests/*.test.ts packages/extension-needle/tests/*.test.ts packages/extension-laya/tests/*.test.ts packages/extension-declarative-recipes/tests/*.test.ts",
    "test:recipes": "tsx --test packages/tool-mode-recipes/tests/*.test.ts packages/extension-declarative-recipes/tests/*.test.ts",
    "test:integration:dsh": "tsx --test packages/dsh-model-as-tool/tests/*.test.ts",
    "test:mcp:2026-07-28": "npm run verify:mcp",
    "test:composition": "tsx --test packages/dsh-model-as-tool/tests/ptc-*.test.ts packages/dsh-model-as-tool/tests/tool-mode-run.test.ts packages/tool-mode-recipes/tests/*.test.ts",
    "test:models:windows": "tsx --test packages/extension-desert-ant-tongue/tests/*.test.ts packages/extension-desert-ant-voz/tests/*.test.ts packages/extension-embeddinggemma/tests/*.test.ts packages/extension-minilm-embed/tests/*.test.ts packages/extension-minilm-rerank/tests/*.test.ts packages/extension-needle/tests/*.test.ts packages/extension-laya/tests/*.test.ts",
    "test:harness:live": "node scripts/report-suite-status.mjs harness-live",
    "test:security:windows": "tsx --test packages/dsh-model-as-tool/tests/authority.test.ts packages/dsh-model-as-tool/tests/ptc-sandbox.test.ts packages/tool-mode-extension-sdk/tests/install.test.ts",
    "test:packaged:windows": "npm run build && npm run verify:built && npm run verify:packed",
    "verify:release": "node scripts/gen-verification.mjs --release-gate",
    "gating": "tsx scripts/gating-report.ts",
    "gen-docs": "node scripts/gen-docs.mjs",
    "traceability": "node scripts/gen-traceability.mjs",
    "verify:traceability": "node scripts/gen-traceability.mjs --check",
    "demo": "tsx scripts/demo.ts",
    "bridge": "node scripts/desert-ant-bridge.mjs",
    "build:ext-tongue": "tsc -p packages/extension-desert-ant-tongue/tsconfig.build.json",
    "build:ext-voz": "tsc -p packages/extension-desert-ant-voz/tsconfig.build.json",
    "verify:architecture": "node scripts/check-architecture.mjs",
    "verify:mcp:fixtures": "node scripts/probe-mcp-conformance.mjs",
    "verify:mcp:live": "tsx --test packages/dsh-model-as-tool/tests/mcp-live-schema.test.ts",
    "verify:mcp": "npm run verify:mcp:fixtures && npm run verify:mcp:live",
    "verification": "node scripts/gen-verification.mjs && node scripts/gen-final-report.mjs",
    "verify:verification": "node scripts/gen-models-index.mjs --check && node scripts/gen-verification.mjs --check",
    "verify:confinement": "node scripts/confinement-acceptance.mjs",
    "release:gate": "node scripts/gen-verification.mjs --release-gate",
    "final-report": "node scripts/gen-final-report.mjs",
    "build:ext-embeddinggemma": "tsc -p packages/extension-embeddinggemma/tsconfig.build.json",
    "build:ext-minilm-embed": "tsc -p packages/extension-minilm-embed/tsconfig.build.json",
    "build:ext-minilm-rerank": "tsc -p packages/extension-minilm-rerank/tsconfig.build.json",
    "test:ext-minilm": "tsx --test packages/extension-minilm-embed/tests/*.test.ts packages/extension-minilm-rerank/tests/*.test.ts",
    "typecheck:ext-minilm": "tsc --noEmit -p packages/extension-minilm-embed/tsconfig.json && tsc --noEmit -p packages/extension-minilm-rerank/tsconfig.json",
    "build:recipes": "tsc -p packages/tool-mode-recipes/tsconfig.build.json",
    "build:ext-needle": "tsc -p packages/extension-needle/tsconfig.build.json",
    "build:ext-laya": "tsc -p packages/extension-laya/tsconfig.build.json",
    "test:ext-laya": "tsx --test packages/extension-laya/tests/*.test.ts",
    "typecheck:ext-laya": "tsc --noEmit -p packages/extension-laya/tsconfig.json",
    "qualify:laya": "node scripts/qualify-laya.mjs",
    "typecheck:ext-needle": "tsc --noEmit -p packages/extension-needle/tsconfig.json && tsc --noEmit -p packages/extension-laya/tsconfig.json",
    "test:sdk": "tsx --test packages/tool-mode-extension-sdk/tests/*.test.ts",
    "test:ext-needle": "tsx --test packages/extension-needle/tests/*.test.ts packages/extension-laya/tests/*.test.ts packages/extension-declarative-recipes/tests/*.test.ts",
    "qualify:voz": "node scripts/qualify-voz.mjs",
    "qualify:voz:smoke": "node scripts/qualify-voz.mjs --smoke",
    "qualify:embeddinggemma": "node scripts/qualify-embeddinggemma.mjs",
    "qualify:embeddinggemma:smoke": "node scripts/qualify-embeddinggemma.mjs --smoke",
    "qualify:minilm": "node scripts/qualify-minilm.mjs",
    "plugin:check": "node packages/dsh-model-as-tool/scripts/check-package.mjs",
    "plugin:install": "node scripts/install-dsh-plugin.mjs",
    "plugin:pack": "npm pack --json --workspace @try-works/dsh-model-as-tool"
  },
  "devDependencies": {
    "@desert-ant-labs/tongue": "^3.6.0",
    "@desert-ant-labs/voz": "^3.6.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.0.0",
    "adm-zip": "^0.5.18",
    "ajv": "^8.20.0",
    "onnxruntime-node": "^1.20.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
