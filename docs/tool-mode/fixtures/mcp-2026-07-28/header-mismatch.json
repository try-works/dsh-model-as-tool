{
  "name": "header-mismatch",
  "describes": "a request whose MCP-Protocol-Version header disagrees with its body",
  "expectation": "HTTP 400 with HeaderMismatch (-32020)",
  "request": {
    "jsonrpc": "2.0",
    "id": "hdr-1",
    "method": "tools/list",
    "params": {
      "_meta": {
        "io.modelcontextprotocol/protocolVersion": "2026-07-28",
        "io.modelcontextprotocol/clientInfo": {
          "name": "tool-mode-conformance",
          "version": "1.0.0"
        },
        "io.modelcontextprotocol/clientCapabilities": {}
      }
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": "hdr-1",
    "error": {
      "code": -32020,
      "message": "the MCP-Protocol-Version header (2025-11-25) does not match the request body (2026-07-28)"
    }
  },
  "http": {
    "status": 400,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    }
  }
}
