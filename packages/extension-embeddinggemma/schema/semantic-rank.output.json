{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "semantic_rank output",
  "description": "Output for semantic_rank: the caller's own candidate IDs in stable descending cosine order, with the score kind and the space declared so the numbers cannot be mistaken for a cross-encoder ranking (MOD-10, TOOL-05).",
  "type": "object",
  "additionalProperties": false,
  "required": ["results", "scoreKind", "embeddingSpaceId", "processing", "meta"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The caller's own candidate id, preserved verbatim. A rank that renumbered its input would be unusable for correlation (MOD-10)."
          },
          "score": {
            "type": "number",
            "minimum": -1,
            "maximum": 1,
            "description": "Cosine similarity against the query. Exact ties are broken by the candidate's original input order, deterministically."
          }
        }
      }
    },
    "scoreKind": {
      "const": "cosine_similarity",
      "description": "Declared so this is never read as the cross-encoder text_rerank score, which is a different quantity from a different model."
    },
    "embeddingSpaceId": {
      "type": "string",
      "minLength": 1,
      "description": "The space the query and every candidate were embedded in (MOD-03)."
    },
    "processing": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/processing" },
      "description": "One entry per embedded item: the query first, then the candidates whose vectors were computed."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract", "contractVersion", "implementationId", "extension",
        "extensionVersion", "activationGeneration", "executionLocation",
        "receiptId", "warnings"
      ],
      "properties": {
        "contract": { "type": "string", "minLength": 1 },
        "contractVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "implementationId": { "type": "string", "minLength": 1 },
        "extension": { "type": "string", "minLength": 1 },
        "extensionVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "activationGeneration": { "type": "integer", "minimum": 0 },
        "executionLocation": { "type": "string", "enum": ["host", "device", "team-server", "remote"] },
        "receiptId": { "type": "string", "minLength": 1 },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "description": "The shared Tool Mode envelope, identical to TOOL_META_SCHEMA in @try-works/tool-mode-contracts (DECL-03)."
    }
  },
  "$defs": {
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "modalities", "sourceRanges", "sampledVideoFrames", "observedAudioSampleRates", "truncated"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["text", "code", "image", "audio", "video"] }
        },
        "sourceRanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["partIndex", "range"],
            "properties": {
              "partIndex": { "type": "integer", "minimum": 0 },
              "range": { "$ref": "#/$defs/timeRange" }
            }
          }
        },
        "sampledVideoFrames": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["partIndex", "timestampsSeconds"],
            "properties": {
              "partIndex": { "type": "integer", "minimum": 0 },
              "timestampsSeconds": { "type": "array", "items": { "type": "number", "minimum": 0 } }
            }
          }
        },
        "observedAudioSampleRates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["partIndex", "sourceHz", "modelHz"],
            "properties": {
              "partIndex": { "type": "integer", "minimum": 0 },
              "sourceHz": { "type": "number", "exclusiveMinimum": 0 },
              "modelHz": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "truncated": {
          "const": false,
          "description": "Always false in v1: an over-context item is rejected rather than silently shortened (MOD-08)."
        }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSeconds", "endSeconds"],
      "properties": {
        "startSeconds": { "type": "number", "minimum": 0 },
        "endSeconds": { "type": "number", "minimum": 0 }
      }
    }
  }
}
