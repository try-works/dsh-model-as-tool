{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "semantic_similarity output",
  "description": "Output for semantic_similarity: one cosine score, the space it was computed in, and the processing record for both sides. `scoreKind` is required because a cosine similarity and a cross-encoder reranker logit are not interchangeable, and a caller that cannot tell them apart will compare two numbers that mean different things (MOD-09, TOOL-05).",
  "type": "object",
  "additionalProperties": false,
  "required": ["score", "scoreKind", "embeddingSpaceId", "processing", "meta"],
  "properties": {
    "score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1,
      "description": "The cosine similarity. It is NOT a probability that the two items mean the same thing, and it is comparable only within the embedding space named below (MOD-09)."
    },
    "scoreKind": {
      "const": "cosine_similarity",
      "description": "Declared so a caller cannot mistake this for a calibrated probability or for a cross-encoder score."
    },
    "embeddingSpaceId": {
      "type": "string",
      "minLength": 1,
      "description": "The space both sides were embedded in. A score is meaningless without it (MOD-03)."
    },
    "processing": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/processing" },
      "description": "One entry per side, in the order left, right."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract", "contractVersion", "implementationId", "extension",
        "extensionVersion", "activationGeneration", "executionLocation",
        "receiptId", "warnings"
      ],
      "properties": {
        "contract": { "type": "string", "minLength": 1 },
        "contractVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "implementationId": { "type": "string", "minLength": 1 },
        "extension": { "type": "string", "minLength": 1 },
        "extensionVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "activationGeneration": { "type": "integer", "minimum": 0 },
        "executionLocation": { "type": "string", "enum": ["host", "device", "team-server", "remote"] },
        "receiptId": { "type": "string", "minLength": 1 },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "description": "The shared Tool Mode envelope, identical to TOOL_META_SCHEMA in @try-works/tool-mode-contracts (DECL-03)."
    }
  },
  "$defs": {
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "modalities", "sourceRanges", "sampledVideoFrames", "observedAudioSampleRates", "truncated"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["text", "code", "image", "audio", "video"] }
        },
        "sourceRanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["partIndex", "range"],
            "properties": {
              "partIndex": { "type": "integer", "minimum": 0 },
              "range": { "$ref": "#/$defs/timeRange" }
            }
          }
        },
        "sampledVideoFrames": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["partIndex", "timestampsSeconds"],
            "properties": {
              "partIndex": { "type": "integer", "minimum": 0 },
              "timestampsSeconds": { "type": "array", "items": { "type": "number", "minimum": 0 } }
            }
          }
        },
        "observedAudioSampleRates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["partIndex", "sourceHz", "modelHz"],
            "properties": {
              "partIndex": { "type": "integer", "minimum": 0 },
              "sourceHz": { "type": "number", "exclusiveMinimum": 0 },
              "modelHz": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "truncated": {
          "const": false,
          "description": "Always false in v1: an over-context item is rejected rather than silently shortened (MOD-08)."
        }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSeconds", "endSeconds"],
      "properties": {
        "startSeconds": { "type": "number", "minimum": 0 },
        "endSeconds": { "type": "number", "minimum": 0 }
      }
    }
  }
}
