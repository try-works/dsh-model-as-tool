{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "semantic_classify input",
  "description": "Input for semantic_classify (MOD-11): one item scored against caller-supplied label descriptions by embedding cosine similarity. The scores are RAW cosines — calibrated is always false, and this tool is not the dedicated decision model. The implementation enforces what JSON Schema cannot express alone: label ids must be unique, and the selection requires best score >= min_score AND (best - runner-up) >= min_margin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["item", "labels"],
  "properties": {
    "item": { "$ref": "#/$defs/item" },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "description": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      },
      "description": "The labels in the caller's order; that order breaks exact score ties."
    },
    "min_score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1,
      "default": 0,
      "description": "The best label must score at least this to be selected (MOD-11)."
    },
    "min_margin": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "default": 0,
      "description": "The best label must beat the runner-up by at least this to be selected (MOD-11)."
    },
    "dimensions": {
      "type": "integer",
      "enum": [768, 512, 256, 128],
      "default": 768,
      "description": "The width the item and every label are embedded at (MOD-04)."
    }
  },
  "$defs": {
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSeconds", "endSeconds"],
      "properties": {
        "startSeconds": { "type": "number", "minimum": 0 },
        "endSeconds": { "type": "number", "minimum": 0 }
      }
    },
    "videoSampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxFrames"],
      "properties": {
        "mode": { "const": "uniform" },
        "maxFrames": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    },
    "mediaPart": {
      "description": "One part of an item, as a closed discriminated union on `kind` (MOD-06).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "code" },
            "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "language": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "image" },
            "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "audio" },
            "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "range": { "$ref": "#/$defs/timeRange" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "video" },
            "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "range": { "$ref": "#/$defs/timeRange" },
            "sampling": { "$ref": "#/$defs/videoSampling" }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parts"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/mediaPart" }
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
