{
  "name": "@try-works/extension-desert-ant-voz",
  "version": "0.1.0",
  "type": "module",
  "description": "First-party Tool Mode extension implementing tool-mode/stt_transcribe on the Desert Ant Labs Voz speech model",
  "license": "MIT",
  "exports": {
    "./tool-mode": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool-mode.extension.json": "./tool-mode.extension.json",
    "./package.json": "./package.json"
  },
  "files": [
