{
  "protocolVersion": "1.1.0",
  "id": "@try-works/extension-desert-ant-voz",
  "version": "0.1.0",
  "displayName": "Desert Ant Voz speech transcription",
  "description": "On-device speech recognition over the Desert Ant Labs Voz model, exposed as the standard tool-mode/stt_transcribe contract.",
  "license": "MIT",
  "activation": {
    "policy": "operator",
    "deactivatable": true
  },
  "runtimeApi": 1,
  "compatibility": {
    "hostApi": "^1.1.0",
    "requiredFeatures": []
  },
  "execution": {
    "kind": "module",
    "entry": "./lib/index.js",
    "isolation": "host-inline"
  },
  "permissions": {
    "networkOrigins": [],
    "inputFiles": true,
    "storage": "extension-private",
    "secrets": [],
    "nativeCode": true
  },
  "models": [
    {
      "id": "voz",
      "assetSet": "voz-weights",
      "assetLock": "./models.lock.json",
      "platforms": [
        {
          "os": "win32",
          "arch": "x64",
          "accelerator": "cpu"
        },
        {
          "os": "darwin",
          "arch": "arm64",
          "accelerator": "gpu"
        },
        {
          "os": "linux",
          "arch": "x64",
          "accelerator": "cpu"
        }
      ]
    }
  ],
  "tools": [
    {
      "id": "voz-stt-transcribe",
      "name": "stt_transcribe",
      "contractId": "tool-mode/stt_transcribe",
      "contractVersion": "1.0.0",
      "description": "On-device speech transcription with honest partial-coverage reporting.",
      "inputSchema": "./schemas/stt-transcribe.input.json",
      "outputSchema": "./schemas/stt-transcribe.output.json"
    }
  ],
  "implementations": [
    {
      "id": "voz-default",
      "contractId": "tool-mode/stt_transcribe",
      "contractVersion": "1.0.0",
      "modelId": "voz",
      "recipeVersion": "1.0.0"
    }
  ],
  "skills": [],
  "licenses": [
    {
      "layer": "code",
      "name": "MIT",
      "url": "https://opensource.org/license/mit",
      "openSource": true,
      "redistribution": "permitted",
      "attributionRequired": false,
      "obligations": []
    },
    {
      "layer": "weights",
      "name": "Desert Ant Labs Source-Available License 1.0",
      "url": "https://license.desertant.com/1.0",
      "openSource": false,
      "redistribution": "not-permitted",
      "attributionRequired": true,
      "attributionText": "Powered by Desert Ant Labs",
      "obligations": [
        "display the attribution notice with a link to Desert Ant Labs",
        "a commercial licence is required above the per-platform, per-model active-device threshold",
        "do not redistribute the model, SDK or a hosted service as a standalone product",
        "do not use outputs or logs to train a competing on-device model",
        "do not extract weights or tamper with the usage telemetry"
      ]
    },
    {
      "layer": "engine",
      "name": "ONNX Runtime (MIT), installed from npm by the operator",
      "url": "https://github.com/microsoft/onnxruntime/blob/main/LICENSE",
      "openSource": true,
      "redistribution": "permitted",
      "attributionRequired": true,
      "attributionText": "ONNX Runtime",
      "obligations": [
        "preserve the ONNX Runtime licence notice"
      ]
    },
    {
      "layer": "sdk",
      "name": "Desert Ant Labs Source-Available License 1.0",
      "url": "https://license.desertant.com/1.0",
      "openSource": false,
      "redistribution": "not-permitted",
      "attributionRequired": true,
      "attributionText": "Powered by Desert Ant Labs",
      "obligations": [
        "do not redistribute the SDK as a standalone product"
      ]
    },
    {
      "layer": "conversion-artifacts",
      "name": "none: the model ships as the vendor published it",
      "url": "https://desertant.com/models/",
      "openSource": false,
      "redistribution": "permitted",
      "attributionRequired": false,
      "obligations": [
        "no conversion step is performed, so no conversion artifact is distributed"
      ]
    }
  ],
  "network": {
    "requiredTelemetry": true,
    "otherNetworkUse": true,
    "telemetryContent": [
      "a monthly active-device count generated by an SDK-generated id"
    ]
  }
}
