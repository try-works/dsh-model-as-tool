{
  "name": "@try-works/tool-mode-extension-sdk",
  "version": "0.1.0",
  "description": "Author-facing SDK for Tool Mode extensions: TMX manifest schema, validation, lifecycle state and management errors",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/try-works/dsh-model-as-tool.git",
    "directory": "packages/tool-mode-extension-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    "./schema/extension-manifest-1.1.0.schema.json": "./schema/extension-manifest-1.1.0.schema.json",
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "bin/*.mjs",
    "schema/*.json",
    "README.md"
  ],
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "dsh-tool-mode": "./bin/dsh-tool-mode.mjs"
  }
}
