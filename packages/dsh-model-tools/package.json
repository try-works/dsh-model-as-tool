{
  "name": "@dsh-plugins/dsh-model-tools",
  "version": "0.1.0",
  "description": "Install Desert Ant Labs on-device models as DSH tools and skills, with per-platform capability gating",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "on-device",
    "desert-ant-labs",
    "models-as-tools"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./catalog": {
      "types": "./lib/types/catalog.d.ts",
      "default": "./lib/catalog.js"
    },
    "./src/*": "./src/*",
    "./catalog/desert-ant-models.json": "./catalog/desert-ant-models.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/catalog.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "catalog/desert-ant-models.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@desert-ant-labs/tongue": "^3.6.0",
    "@desert-ant-labs/voz": "^3.6.0",
    "onnxruntime-node": "^1.20.0"
  },
  "scripts": {
    "test": "node --test tests/"
  }
}
