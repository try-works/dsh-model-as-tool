{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt", "levels"],
  "properties": {
    "prompt": { "type": "string", "minLength": 1, "maxLength": 4096, "description": "The scoring prompt." },
    "levels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true,
      "description": "The ordinal levels from lowest to highest; duplicate labels are refused."
    },
    "allow_abstain": { "type": "boolean", "default": true }
  }
}
