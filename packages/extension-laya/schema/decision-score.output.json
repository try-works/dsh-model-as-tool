{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["score", "confidence", "calibrated", "probabilities", "abstained"],
  "properties": {
    "score": { "type": ["string", "null"], "description": "The scored level label, or null when abstained." },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "EXPLICITLY UNCALIBRATED (DEC-08)." },
    "calibrated": { "const": false },
    "probabilities": { "type": "object", "additionalProperties": { "type": "number" }, "description": "Per-level softmax scores (uncalibrated)." },
    "abstained": { "type": "boolean" },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "act_probability": { "type": "number" } }
    }
  }
}
