{
  "name": "@try-works/dsh-model-as-tool",
  "version": "0.1.1",
  "description": "Install Desert Ant Labs on-device models as DSH tools and skills, with per-platform capability gating",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "on-device",
    "desert-ant-labs",
    "models-as-tools"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/try-works/dsh-model-as-tool.git",
    "directory": "packages/dsh-model-as-tool"
  },
  "homepage": "https://github.com/try-works/dsh-model-as-tool#readme",
  "bugs": {
    "url": "https://github.com/try-works/dsh-model-as-tool/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./catalog": {
      "types": "./lib/catalog.d.ts",
      "default": "./lib/catalog.js"
    },
    "./src/*": "./src/*",
    "./catalog/desert-ant-models.json": "./catalog/desert-ant-models.json",
    "./catalog/playbooks.json": "./catalog/playbooks.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "catalog/desert-ant-models.json",
    "catalog/playbooks.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@desert-ant-labs/tongue": "^3.6.0",
    "@desert-ant-labs/voz": "^3.6.0",
    "onnxruntime-node": "^1.20.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@try-works/tool-mode-contracts": "^0.1.0"
  }
}
