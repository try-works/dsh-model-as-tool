{
  "protocolVersion": "1.1.0",
  "id": "@try-works/fixture-ext-service",
  "version": "1.0.0",
  "displayName": "Extension service fixture",
  "description": "A deterministic extension used to prove the host's describe/install/enable/disable surface. It owns no model and performs no inference, so every observation is reproducible without a runtime, weights or a network.",
  "activation": {
    "policy": "operator",
    "deactivatable": true
  },
  "runtimeApi": 1,
  "compatibility": {
    "hostApi": "^1.1.0",
    "requiredFeatures": []
  },
  "execution": {
    "kind": "module",
    "entry": "./lib/index.js"
  },
  "permissions": {
    "networkOrigins": [],
    "inputFiles": false,
    "storage": "extension-private",
    "secrets": [],
    "nativeCode": false
  },
  "network": {
    "requiredTelemetry": false,
    "otherNetworkUse": false
  },
  "licenses": [
    {
      "layer": "code",
      "name": "MIT",
      "url": "https://opensource.org/license/mit",
      "openSource": true,
      "redistribution": "permitted",
      "attributionRequired": false,
      "obligations": []
    },
    {
      "layer": "engine",
      "name": "none: the fixture implements its tool directly",
      "url": "https://example.invalid/fixture",
      "openSource": true,
      "redistribution": "permitted",
      "attributionRequired": false,
      "obligations": []
    },
    {
      "layer": "weights",
      "name": "none: the fixture owns no model",
      "url": "https://example.invalid/fixture",
      "openSource": true,
      "redistribution": "permitted",
      "attributionRequired": false,
      "obligations": []
    },
    {
      "layer": "sdk",
      "name": "MIT",
      "url": "https://opensource.org/license/mit",
      "openSource": true,
      "redistribution": "permitted",
      "attributionRequired": false,
      "obligations": []
    },
    {
      "layer": "conversion-artifacts",
      "name": "none: no conversion step is performed",
      "url": "https://example.invalid/fixture",
      "openSource": true,
      "redistribution": "permitted",
      "attributionRequired": false,
      "obligations": []
    }
  ],
  "models": [],
  "tools": [
    {
      "id": "fixture-tool",
      "name": "fixture_ext_tool",
      "contractId": "fixture.ext-service.echo",
      "contractVersion": "1.0.0",
      "description": "Echo the supplied token back to prove a call reached this extension. It performs no inference and touches no file or network.",
      "inputSchema": "./schemas/input.json",
      "outputSchema": "./schemas/output.json"
    }
  ],
  "implementations": [
    {
      "id": "fixture-tool",
      "contractId": "fixture.ext-service.echo",
      "contractVersion": "1.0.0",
      "recipeVersion": "1.0.0"
    }
  ],
  "skills": []
}
